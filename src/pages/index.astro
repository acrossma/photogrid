---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

// Import both images and videos
const mediaFiles = import.meta.glob<{ default: ImageMetadata | string }>(
  "../images/*.{jpg,jpeg,png,webp,gif,mp4,webm}",
);

// Convert to an array and sort descending (newest first based on filenames/dates like 20261110)
const sortedMedia = Object.entries(mediaFiles).sort(([pathA], [pathB]) =>
  pathB.localeCompare(pathA, undefined, { numeric: true, sensitivity: "base" }),
);
---

<BaseLayout
  title="Astro Photo Grid"
  description="A minimal, single-page photo gallery for Astro."
>
  <section class="justified-gallery" id="photoswipe">
    {sortedMedia.map(async ([path, resolver], index) => {
      const resolved = await resolver();
      const isVideo = path.endsWith('.mp4') || path.endsWith('.webm');

      if (isVideo) {
        const vidWidth = 16;
        const vidHeight = 9;
        // Explicitly cast the resolved source to a string for TypeScript
        const videoSrc = resolved.default as string;
        return (
          <div
            class="video-wrapper cursor-pointer"
            style={`--width: ${vidWidth}; --height: ${vidHeight};`}
          >
            <video
              autoplay
              muted
              loop
              playsinline
              class="grid-video"
              onclick="this.muted = !this.muted; this.controls = !this.muted;"
            >
              <source src={videoSrc} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        );
      }

      const imageData = resolved.default as ImageMetadata;
      return (
        <a
          style={`--width: ${imageData.width}; --height: ${imageData.height};`}
          href={imageData.src}
          target="_blank"
          data-fancybox="gallery"
        >
          <Image
            format="webp"
            src={imageData}
            alt=""
            height={400}
            loading={index < 20 ? "eager" : "lazy"}
          />
        </a>
      );
    })}
  </section>
</BaseLayout>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

  Fancybox.bind("[data-fancybox]", {
    theme: "auto",
    mainStyle: {
      "--f-button-width": "44px",
      "--f-button-height": "44px",
      "--f-button-border-radius": "50%",
      "--f-toolbar-padding": "16px",
    },
    Carousel: {
      Arrows: false,
      Toolbar: {
        display: {
          left: [],
          middle: [],
          right: ["close"],
        },
      },
      transition: "slide",
    },
  });
</script>

<style>
  .justified-gallery {
    --padding: max(2.5vw, 12px);
    --space: max(2.5vw, 12px);
    --min-height: clamp(200px, 20vw, 400px);

    padding: var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);

    a, .video-wrapper {
      flex-grow: calc(var(--width) * (100000 / var(--height)));
      flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
      aspect-ratio: var(--width) / var(--height);
      overflow: hidden;
      opacity: 1;
      transition: all 0.05s ease-in-out;
    }

    a img, .grid-video {
      display: block;
      object-fit: cover;
      height: 100%;
      width: 100%;
    }

    a:focus-visible {
      outline: 3px solid var(--outline);
      outline-offset: 2px;
      transform: scale(1.05);
      z-index: 1;
      border-radius: 2px;
      box-shadow: 0 2px 4px 2px rgba(0, 0, 0, 0.1);
    }

    a.hidden {
      transition: opacity 0.4s ease-in-out;
      opacity: 0;
    }

    /* Prevent awkward gap from showing after image in last row */
    &::after {
      content: "";
      flex-grow: 1000000000;
    }

    /* Mobile-only */
    @media (width < 640px) {
      &::after {
        display: none;
      }
    }
  }
</style>